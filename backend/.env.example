GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=insurance_knowledge_base
DOCUMENT_DIRECTORY=../insurance_rag_knowledge_base
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.35
APP_NAME=Insurance RAG Q&A API
APP_VERSION=1.0.0
DEBUG=True
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173

# Context Budget Limits
RETRIEVAL_CANDIDATES=10
FINAL_TOP_K=5
MAX_CONTEXT_CHARS=12000
MAX_CONTEXT_TOKENS=3000
MAX_CHUNK_CHARS=2500
MAX_CHUNKS_PER_DOCUMENT=2
ENABLE_RAG_DEBUG=false

# Semantic Response Cache
ENABLE_RESPONSE_CACHE=true
SEMANTIC_CACHE_THRESHOLD=0.92
CACHE_MAX_RESULTS=3
CACHE_TTL_HOURS=168
KNOWLEDGE_BASE_VERSION=v1
CHROMA_CACHE_COLLECTION_NAME=insurance_response_cache

# Voice / Speech-to-Text
ENABLE_VOICE_INPUT=true
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
MAX_AUDIO_DURATION_SECONDS=60
MAX_AUDIO_FILE_SIZE_MB=10
SUPPORTED_AUDIO_FORMATS=webm,wav,mp3,m4a,ogg

# Conversational Memory & Contextualization
MAX_HISTORY_MESSAGES=10
CONVERSATION_DB_PATH=./conversations.db
